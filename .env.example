# Copy to .env and fill in as needed. All variables are optional.

# --- Frontend (Vite) ---
# Override the API base URL the frontend calls. Default "/api" (proxied to the
# backend by the Vite dev server). Leave unset for local development.
# VITE_API_BASE_URL=/api

# --- Backend (Express) ---
# Port for the local API server (default 3001). Named API_PORT (not PORT) so it
# never collides with the frontend dev server port.
# API_PORT=3001

# LLM provider for the AI chat (InvokeLLM). If neither key is set, the backend
# returns an offline mock response so the app still works.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Optional model override (defaults: claude-opus-4-8 / gpt-4o-mini).
# LLM_MODEL=claude-opus-4-8

# --- Site telemetry (Baustellen-Leitstand) ---
# Active source: simulation | mqtt | webrtc (default simulation).
# TELEMETRY_SOURCE=simulation
# MQTT broker over WebSockets (also run `npm i mqtt` to enable the client).
# MQTT_URL=wss://broker.example.com:8084/mqtt
# MQTT_TOPIC_TELEMETRY=site/+/telemetry
# MQTT_TOPIC_COMMAND=site/{unitId}/command
# WebRTC signaling gateway (e.g. RTSP→WebRTC / WHEP) for on-site camera feeds.
# WEBRTC_SIGNALING_URL=wss://gateway.example.com/webrtc
# Weather uses Open-Meteo (no key required); no config needed.

# IFC-Viewer (Phase 30, JB-Rueckgabe 260821) — rein lesende dev-Pfade fuer /IfcViewer:
# IFC_DIR=/pfad/zum/ifc-ordner
# IFC_TEST_FILE=/pfad/zur/datei.ifc
# NOVA_FILTER_DIR=/pfad/zu/FILTER_NOVAAVA/<Projekt>

# --- Lokale API: Netzbindung und erlaubte Origins (Sicherheit, 07.09.2026) ---
# Der Dienst hat KEINE eigene Anmeldung (routes.js liefert einen festen DEV_USER).
# Deshalb bindet er auf 127.0.0.1 und laesst nur die eigenen Dev-/Preview-Origins zu.
# API_HOST=0.0.0.0        # nur setzen, wenn der Zugriff aus dem LAN ausdruecklich gewollt ist
# API_ORIGINS=http://localhost:1420,tauri://localhost   # zusaetzliche Origins, kommagetrennt

# --- Phase 57: Supabase (Konten & Abrechnung, Stufe 1) -----------------------
# Keys: Supabase Dashboard -> Settings -> API. The anon key is public by
# design (RLS protects the data); the service_role key bypasses RLS and must
# NEVER reach the browser or a commit. Values go into .env only.
SUPABASE_URL_DEV=
SUPABASE_ANON_DEV=
SUPABASE_SERVICE_DEV=
SUPABASE_URL_PROD=
SUPABASE_ANON_PROD=
SUPABASE_SERVICE_PROD=
# Client build (57-02): setting VITE_SUPABASE_URL switches DATENQUELLE to
# 'supabase'. Both are baked into the bundle at build time and public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TypeSafe (Phase 76): typisierte KI-Urteile (Kostengruppen-Vorschlag). Ohne Schluessel
# antwortet /api/integrations/typesafe mit 503 - es gibt bewusst keinen Mock.
# TYPESAFE_API_KEY=ts_...
