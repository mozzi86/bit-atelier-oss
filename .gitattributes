# 87-04: ONE line-ending rule for the whole repo — text files are stored and checked
# out with LF (attribute beats core.autocrlf=true on the Windows clones). Before,
# 1 672 tracked files sat with CRLF in the working tree and 713 with LF, every
# edit by a tool that writes LF produced whole-file phantom diffs, and patch
# scripts needed "\r\n" normalisation (tesselierung.js). Exceptions below keep
# their own ending on purpose. Git detects binaries itself (text=auto).
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Generated files that tests compare byte for byte with their generator output
# (tests/unit/beispielmodell.test.js; the reference-project IDS lives in the NDA archive since Plan 83-01). The generators
# write LF; with core.autocrlf=true (Windows default) a fresh clone would check
# them out with CRLF and the byte-identity tests fail although nothing changed.
public/beispiel/*.ifc text eol=lf
public/beispiel/*.ids text eol=lf
public/pruefregeln/*.ids text eol=lf
public/pruefregeln/*.json text eol=lf

# 83-03: start scripts of the downloadable release. start.sh must keep LF (a CRLF
# shebang line fails with "bad interpreter" on macOS/Linux, also in a ZIP built
# on Windows); start-windows.cmd keeps CRLF (cmd's goto/label search misreads
# LF-only batch files).
*.sh text eol=lf
*.cmd text eol=crlf

# 79-11: the DATEV EXTF golden fixture's CRLF is protocol DATA (every row must end
# 0x0D 0x0A), not a line-ending style choice — `-text` stops autocrlf from silently
# stripping it to LF on add (found while writing tests/unit/buchhaltung-datev.test.js:
# the staged blob had 0 CR bytes although the working file had the real CRLF pairs).
tests/unit/fixtures/buchhaltung/datev/EXTF_Buchungsstapel_golden.csv -text
