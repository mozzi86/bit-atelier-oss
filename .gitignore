#          parity/oracle/.venv/bin/pip install -r parity/oracle/requirements.txt
parity/oracle/.venv/

# Phase 33: Ausgabe des Einmal-Transformers (auf Zuruf neu erzeugbar)
*.novabundle.json

# Phase 33 / W5: die erzeugte Kostenberechnungs-XLSX. Wird von Gate G14 bei
# JEDEM Lauf neu gebaut und gegen die goldene Referenzdatei verglichen. Nicht
# eingecheckt — ein eingechecktes Artefakt kann von seinem Erzeuger abdriften,
# ohne dass ein Gate rot wird. Der Vergleichsanker ist die Referenzdatei im
# NDA-Archiv (BIT_NDA_DIR), nicht diese Ausgabe.
parity/artifacts/kb.xlsx

# Plan 83-01: Kunden-/NDA-Material liegt AUSSERHALB des Repos und wird über
# BIT_NDA_DIR gelesen (siehe tests/nda.mjs und
# .planning/phases/83-open-source/83-01-SUMMARY.md). Die Muster sind bewusst
# generisch — kein Projekt- oder Kundenname gehört in diese Datei.
server/db.json.*
parity/fixtures/
parity/golden/
parity/oracle/
parity/artifacts/*.json
.planning/quellen/rohbau-bim-*/
tests/unit/fixtures/loi-*.csv
# lokale Ersetzungs- und Sperrliste (Klartext) für projektnamen-anwenden.mjs
.planning/tools/*.local.json

# Phase 33 / W7: das von Gate G20 vollständig gebaute KUNDENPAKET (assemble +
# npm install + seed + vite build). Enthält ein eigenes node_modules und dist/
# und wird bei jedem Lauf neu zusammengesetzt; der Install wird wiederverwendet,
# solange der Ordner steht. Frischer Nachweis: Ordner löschen, `npm run parity`.
parity/artifacts/verkaufspaket*/
parity/artifacts/guardprobe*/

