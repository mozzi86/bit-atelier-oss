{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "client": {
      "type": "string",
      "description": "Client organization"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "zoning_set": {
      "type": "object",
      "properties": {
        "far_max": {
          "type": "number"
        },
        "height_max": {
          "type": "number"
        },
        "setbacks": {
          "type": "object",
          "properties": {
            "front": {
              "type": "number"
            },
            "side": {
              "type": "number"
            },
            "rear": {
              "type": "number"
            }
          }
        },
        "parking_ratio": {
          "type": "number"
        }
      }
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "GEG",
          "DIN_18599",
          "DIN_4108",
          "DIN_276",
          "HOAI",
          "VOB"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "feasibility",
        "design",
        "construction",
        "handover"
      ],
      "default": "feasibility"
    },
    "nda": {
      "type": "boolean",
      "default": false,
      "description": "NDA marker (106-05, D-IM-02): images of the view never go to a language model, only text and element GUIDs"
    },
    "bild_freigabe": {
      "type": ["object", "null"],
      "default": null,
      "properties": {
        "am": { "type": "string", "description": "ISO date of the consent" },
        "durch": { "type": "string", "description": "who consented ('person')" }
      },
      "description": "106-06 (D-IM-02): the person's consent, once per project, that images of the view may leave this computer for a language model. Set only through POST /api/llm/bild-zustimmung from the app; ignored when nda is true"
    }
  },
  "required": [
    "name",
    "client",
    "location"
  ]
}