{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "./packages/nova-core/src/*"
      ],
      "@ifc/*": [
        "./packages/nova-ifc-viewer/src/*"
      ],
      "@ava/*": [
        "./packages/nova-ausschreibung/src/*"
      ],
      "@pdf/*": [
        "./packages/nova-pdf/src/*"
      ],
      "@designer/*": [
        "./packages/nova-designer/src/*"
      ],
      "@sketch/*": [
        "./packages/bit-sketch/src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom"
    ],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-dom"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "packages/*/src/**/*.js",
    "packages/*/src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/components/ui",
    "packages/nova-core/src/components/ui",
    "packages/nova-core/server",
    "**/*.test.js"
  ]
}
