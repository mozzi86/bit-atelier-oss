{
  "name": "bit-atelier",
  "private": true,
  "license": "MIT",
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js --app",
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "seed": "node server/seed.js",
    "build": "vite build",
    "build:lokal": "vite build --mode lokal --base /app/ --outDir dist-lokal && node scripts/build-sw.mjs lokal",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "preview:lokal": "vite preview --outDir dist-lokal --base /app/ --port 4173 --strictPort",
    "test:unit": "node --test --import ./tests/alias-register.mjs \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build:cloud": "node scripts/build-cloud.mjs",
    "smoke:cloud": "playwright test tests/e2e/cloud-smoke.spec.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@hookform/resolvers": "^4.1.2",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
